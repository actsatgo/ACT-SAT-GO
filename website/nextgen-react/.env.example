# URL of the test-platform app's login page that the "Login" button opens.
# Local dev (frontend Vite app): http://localhost:5173/login
# Production: set this to your deployed app login, e.g.
# VITE_APP_LOGIN_URL=https://app.actsatgo.com/login
VITE_APP_LOGIN_URL=http://localhost:5173/login

# Meta (Facebook) Pixel ID from Meta Events Manager. The base pixel loads on
# every page (firing PageView) and a Lead event fires on successful
# consultation-form submissions. Defaults to the production pixel ID
# (see META_PIXEL_ID in src/config.ts) — override here to point at a
# different pixel, or set to a blank value to disable tracking locally.
VITE_META_PIXEL_ID=1271262211876885

# Base URL of the platform (Next.js) API used by the Free Demo Test signup.
# Defaults to the Render deployment (https://act-sat-go.onrender.com). Only set
# this when running the platform locally — never point it at the frontend SPA.
# VITE_PLATFORM_API_BASE=http://localhost:3000

# Canonical site origin used for canonical URLs, Open Graph tags, sitemap.xml
# and robots.txt (generated at build time by scripts/prerender.mjs).
# VITE_SITE_URL=https://actsatgo.com

# Self-booking calendar for the free diagnostic lesson (Calendly / Cal.com).
# When set, the /consultation page embeds it so parents can pick a time
# instead of waiting for a call back.
# VITE_BOOKING_URL=https://calendly.com/your-team/free-diagnostic

# Google Analytics 4 measurement ID. Enables page views on every route and a
# generate_lead conversion on every successful lead form.
# VITE_GA4_ID=G-XXXXXXXXXX

# Optional Google Ads conversion ("AW-123456789/AbCdEfGh") fired on leads.
# VITE_GOOGLE_ADS_CONVERSION=
